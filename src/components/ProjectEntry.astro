---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, status, tags, repoUrl, date } = project.data;
const href = `/projects/${project.slug}`;
const displayDate = date && new Intl.DateTimeFormat("en", { month: "short", year: "numeric", timeZone: "UTC" }).format(date);
---

<article class="indexed-entry project-entry">
  <span class="folio" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
  <div>
    <p class="entry-meta">
      {date && <time datetime={date.toISOString().slice(0, 10)}>{displayDate}</time>}
      {status}
    </p>
    <h2 class="project-entry-title"><a href={href}>{title}</a></h2>
    <p class="entry-summary">{summary}</p>
    <div class="project-entry-foot">
      <p class="project-topics">{tags.join(" · ")}</p>
      {repoUrl && <a href={repoUrl} aria-label={`${title} on GitHub`}>GitHub <span aria-hidden="true">&nearr;</span></a>}
    </div>
  </div>
</article>
