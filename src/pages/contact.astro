---
import BaseLayout from "../layouts/BaseLayout.astro";
import ObfuscatedEmail from "../components/ObfuscatedEmail.astro";
import { profile } from "../data/profile";
---

<BaseLayout title="Contact | Shiqing Gao" description="Email, GitHub, and website information for Shiqing Gao.">
  <div class="container reading-page narrow-page">
    <header class="page-header">
      <h1>Contact</h1>
      <p>For academic or project-related messages, email is usually the best way to reach me.</p>
    </header>
    <dl class="contact-list">
      <div>
        <dt>Email</dt>
        <dd><ObfuscatedEmail label={profile.emailLabel} parts={profile.emailParts} /></dd>
      </div>
      <div>
        <dt>GitHub</dt>
        <dd><a href={profile.github}>github.com/gaoshiqingcuhk</a></dd>
      </div>
      <div>
        <dt>Website</dt>
        <dd><a href={profile.website}>www.gaoshiqing.space</a></dd>
      </div>
    </dl>
  </div>
</BaseLayout>
