---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await project.render();
const links = [
  project.data.repoUrl && { label: "Repository", href: project.data.repoUrl },
  project.data.demoUrl && { label: "Live site", href: project.data.demoUrl },
  project.data.reportUrl && { label: "Report", href: project.data.reportUrl }
].filter((link) => link && link.href);
---

<BaseLayout title={`${project.data.title} | Shiqing Gao`} description={project.data.summary} lang="en">
  <article class="container project-page">
    <header class="page-header project-header">
      <a class="back-link" href="/projects"><span aria-hidden="true">&larr;</span> Projects</a>
      <h1>{project.data.title}</h1>
      <p>{project.data.summary}</p>
    </header>
    <div class="project-body-grid">
      <aside class="project-aside" aria-label="Project details">
        <dl class="project-facts">
          <div><dt>Category</dt><dd>{project.data.category}</dd></div>
          <div><dt>Status</dt><dd>{project.data.status}</dd></div>
          <div><dt>Role</dt><dd>{project.data.role}</dd></div>
          <div><dt>Tools</dt><dd>{project.data.tools.join(", ")}</dd></div>
          <div><dt>Topics</dt><dd>{project.data.tags.join(" · ")}</dd></div>
        </dl>
        <div class="project-links">
          {links.map((link) => link && <a href={link.href}>{link.label} <span aria-hidden="true">&nearr;</span></a>)}
        </div>
      </aside>
      <div class="prose project-prose"><Content /></div>
    </div>
  </article>
</BaseLayout>
