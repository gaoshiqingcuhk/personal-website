---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectEntry from "../../components/ProjectEntry.astro";
import { profile } from "../../data/profile";
import { sortProjectsByDate } from "../../utils/projects";

const selectedProjectSlugs = new Set([
  "image-inverse-problems-denoising",
  "subdiffusion-mode-decay",
  "machine-learning-uncertainty-quantification",
  "mathematical-modeling-optimization"
]);

const projects = sortProjectsByDate(await getCollection("projects")).filter((project) =>
  selectedProjectSlugs.has(project.slug)
);
---

<BaseLayout
  title="Projects | Shiqing Gao"
  description="Research and computational projects by Shiqing Gao in Lean 4, mathematical proof checking, inverse problems, uncertainty quantification, and optimization."
>
  <div class="container reading-page">
    <header class="page-header">
      <h1>Projects</h1>
      <p>Ongoing research and selected computational projects.</p>
    </header>
    <ol class="editorial-list project-index">
      {profile.research.map((item, index) => (
        <li>
          <article class="indexed-entry project-entry">
            <span class="folio" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
            <div>
              <h2 class="project-entry-title">{item.title}</h2>
              <p class="entry-summary">{item.context}</p>
            </div>
          </article>
        </li>
      ))}
      {projects.map((project, index) => <li><ProjectEntry project={project} index={index + profile.research.length} /></li>)}
    </ol>
  </div>
</BaseLayout>
