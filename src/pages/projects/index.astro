---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectEntry from "../../components/ProjectEntry.astro";

const selectedProjectSlugs = [
  "formalization-of-mathematics-in-lean-4",
  "ai-assisted-error-detection-in-mathematical-proofs",
  "image-inverse-problems-denoising",
  "subdiffusion-mode-decay",
  "machine-learning-uncertainty-quantification",
  "mathematical-modeling-optimization"
];

const allProjects = await getCollection("projects");
const projects = selectedProjectSlugs.flatMap((slug) =>
  allProjects.filter((project) => project.slug === slug)
);
---

<BaseLayout
  title="Projects | Shiqing Gao"
  description="Research and computational projects by Shiqing Gao in Lean 4, mathematical proof checking, inverse problems, uncertainty quantification, and optimization."
>
  <div class="container reading-page">
    <header class="page-header">
      <h1>Projects</h1>
      <p>Ongoing research and selected computational projects.</p>
    </header>
    <p class="project-workflow">
      For the four computational projects, much of the code was produced with AI
      assistance. My work focused on directing experiments, examining outputs,
      checking results, and interpreting the findings.
    </p>
    <ol class="editorial-list project-index">
      {projects.map((project, index) => <li><ProjectEntry project={project} index={index} /></li>)}
    </ol>
  </div>
</BaseLayout>

<style>
  .project-workflow { max-width: 67ch; margin-bottom: 1.25rem; color: var(--muted); }
</style>
