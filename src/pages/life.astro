---
import BaseLayout from "../layouts/BaseLayout.astro";

const interests = [
  ["Writing", "Practicing clear explanations and keeping technical notes readable."],
  ["Languages", "Thinking about precise expression across English and Chinese."],
  ["Design", "Noticing how layout, typography, and structure affect readability."],
  ["Music", "A small personal interest that helps keep study and daily life balanced."]
];
---

<BaseLayout title="Life | Shiqing Gao" description="Shiqing Gao's interests in writing, languages, design, and music." noindex>
  <div class="container reading-page narrow-page">
    <header class="page-header">
      <h1>Life</h1>
      <p>A few interests beyond mathematics.</p>
    </header>
    <dl class="life-list">
      {interests.map(([title, description]) => (
        <div><dt>{title}</dt><dd>{description}</dd></div>
      ))}
    </dl>
  </div>
</BaseLayout>
