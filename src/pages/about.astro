---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title="About | Shiqing Gao"
  description="About Shiqing Gao, an undergraduate mathematics student at The Chinese University of Hong Kong."
>
  <div class="container reading-page">
    <header class="page-header">
      <h1>About</h1>
      <p>I am an undergraduate mathematics student at {profile.university}.</p>
    </header>

    <section class="editorial-section" aria-labelledby="focus">
      <h2 id="focus">Current interests</h2>
      <ul class="marginal-list">
        {profile.currentInterests.map((interest) => <li>{interest}</li>)}
      </ul>
    </section>

    <section class="editorial-section" aria-labelledby="experiments">
      <h2 id="experiments">Computational work</h2>
      <div class="prose">
        <p>
          My computational projects explore image inverse problems, spectral
          intuition for diffusion, and uncertainty in machine learning.
          I like to start with a small numerical experiment, compare it with
          a baseline, and write down what failed as well as what worked.
        </p>
        <a href="/projects">Browse the projects <span aria-hidden="true">&rarr;</span></a>
      </div>
    </section>

    <section class="editorial-section" aria-labelledby="elsewhere">
      <h2 id="elsewhere">Beyond coursework</h2>
      <div class="prose">
        <p>I am also interested in writing, languages, design, and music.</p>
        <div class="inline-links"><a href="/cv">CV</a><a href="/contact">Contact</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
