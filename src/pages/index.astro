---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { site } from "../data/site";
---

<BaseLayout title={site.title} description={site.description}>
  <header class="container home-intro">
    <div>
      <h1>{profile.name}</h1>
      <p class="home-lead">
        I am a mathematics undergraduate at {profile.university}, and this is my personal website.
      </p>
    </div>
    <img class="home-portrait" src="/shiqing-gao.webp" alt={`Portrait of ${profile.name}`} width="560" height="746" />
  </header>
</BaseLayout>
